# Java & IntelliJ IDEA 프로젝트에 최적화된 .gitignore

# 컴파일된 클래스 파일
*.class

# 로그 파일
*.log

# BlueJ 파일
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# 패키지 파일
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# 가상머신 크래시 로그
hs_err_pid*
replay_pid*

# IntelliJ IDEA 관련
.idea/
*.iml
out/

# 빌드 도구별(Gradle/Maven) 디렉터리
/build/
/target/

# OS별 임시 파일
.DS_Store
Thumbs.db

# 기타
*.swp
*.swo

# properties 파일 (필요시 제외)
src/main/resources/*.properties

# target 디렉터리 제외 (필요시 포함)
/target/

.smarttomcat/
